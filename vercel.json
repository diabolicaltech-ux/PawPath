{
  "framework": null,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self), usb=(), serial=(), midi=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/breed-health",
      "destination": "/breed-health/breed-health.html"
    },
    {
      "source": "/breed-health/:slug",
      "destination": "/breed-health/:slug.html"
    },
    {
      "source": "/tools/:slug",
      "destination": "/tools/:slug.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/terms",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
